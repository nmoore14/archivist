ARCHIVIST_DB_PATH=/data/archivist.db
ARCHIVIST_STORAGE_PATH=/data/storage
ARCHIVIST_UPLOAD_PATH=/data/uploads
# Default bundled Ollama endpoint. For a host PC's Ollama use
# http://host.docker.internal:11434 with docker-compose.external-ollama.yml.
OLLAMA_BASE_URL=http://ollama:11434
ARCHIVIST_DEFAULT_MODEL=gemma3:1b
ARCHIVIST_EMBED_MODEL=nomic-embed-text
ARCHIVIST_HTTP_ADDR=:8080
ARCHIVIST_HOST_BIND=127.0.0.1
# Use "personal" to skip accounts and turn workspaces into private study spaces.
# Keep this server bound to localhost when running without login protection.
ARCHIVIST_MODE=school
